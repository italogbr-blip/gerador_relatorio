{
  "buildCommand": "cd core-app && npm install && npm run build",
  "outputDirectory": "core-app/dist",
  "rewrites": [
    {
      "source": "/painel_coord",
      "destination": "/painel_coord/index.html"
    },
    {
      "source": "/meus_relatorios",
      "destination": "/meus_relatorios/index.html"
    },
    {
      "source": "/coord",
      "destination": "/coord/index.html"
    },
    {
      "source": "/ver_relatorio",
      "destination": "/ver_relatorio/index.html"
    },
    {
      "source": "/((?!assets/|_expo/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
